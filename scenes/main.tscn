[node name="CryoChamber" parent="RoomManager" unique_id=1423448244 instance=ExtResource("3_jyhfs")]
visible = true
offset_left = 372.0
offset_top = -290.0
offset_right = -530.0
offset_bottom = -738.0
lockable_exits = Array[String](["junction a1"])
room_name = "Cryo Chamber"
room_description = "The whine of the cryo pod lid rouses you from your artificial sleep as the lights automatically flicker on. Looking around the room you can see two other cryo pods, empty with their lids open.

A faint smell of burnt electronics and the lingering scent of chemicals fills your nostrils, not quite overpowering but nearing the threshold.

A computer terminal flashes near a door labeled \"Jct. A1\"."
terminals = Array[ExtResource("6_eb6dy")]([SubResource("Resource_jbj1t")])
short_description = "In the center of the room, the three cryo pods remain open. The faint smell of burnt electronics returns to your senses as the lights flicker intermittently.

A computer terminal flashes in the corner of the room."
hidden_items = Array[String](["wrench"])
search_text = "Upon inspecting the room you locate the cause of the burning electronics. The panel that houses the components of your cryopod bends outward as if beaten open. Cabling that was once securely in place is now seemingly ripped out of the control panel. A pipe wrench lays under the cryo pod.

You're lucky the cryo pod was functional enough to keep you alive, let alone able to wake you again."

[node name="JunctionA1" parent="RoomManager" unique_id=833546915 instance=ExtResource("3_jyhfs")]
