hiding_spots = Array[String](["under mess hall table", "fridge"])
room_name = "Mess Hall"
room_description = "Normally a welcome sight, the current state of the Mess Hall would leave Captain Webber with a veiny bulge in her neck on the brink of bursting.

Shards of ceramic and glass cover the table. Several cabinets are left open and a slight creak emanates from the fridge as it slightly swings back and forth."
items = Array[String](["pda"])
short_description = "The fridge lightly creaks and the broken plates and mugs litter the table."

